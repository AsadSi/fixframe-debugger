"""Fixframe's command line.

    fixframe open <file.ffcap> [--port N]   the UI on a saved capture, with no game running

The UI is the one the layer serves (ui/ next to this script's folder), over the same API, read-only: pick, scrub
and capture need the game.
"""
import argparse
import base64
import http.server
import json
import os
import sys
import webbrowser

UI = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "ui")
TYPES = {".html": "text/html; charset=utf-8", ".css": "text/css; charset=utf-8", ".js": "text/javascript; charset=utf-8"}


def serve(path, port):
    with open(path, encoding="utf-8") as f:
        doc = json.load(f)
    if doc.get("fixframe") != 1:
        sys.exit(f"{path} is not a Fixframe capture")
    capture = json.dumps(doc["capture"]).encode()
    image = base64.b64decode(doc["image"]) if doc.get("image") else b""
    c = doc["capture"]
    status = json.dumps({"app": doc["app"], "device": doc["device"], "backend": doc["backend"], "offline": os.path.basename(path),
                         "frame": c["frame"], "draws": len(c["draws"]), "fps": 0,
                         "captures": [{"id": c["id"], "frame": c["frame"], "draws": len(c["draws"])}]}).encode()
    host = f"127.0.0.1:{port}", f"localhost:{port}"

    class Handler(http.server.BaseHTTPRequestHandler):
        def send(self, code, body, kind="application/json"):
            self.send_response(code)
            self.send_header("Content-Type", kind)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def allowed(self):  # as the layer's server: our own page, at our own name
            origin = self.headers.get("Origin")
            return self.headers.get("Host") in host and (not origin or origin in [f"http://{h}" for h in host])

        def do_GET(self):
            if not self.allowed():
                return self.send(403, b"")
            path = self.path.split("?")[0]
            if path == "/api/status":
                return self.send(200, status)
            if path == f"/api/captures/{c['id']}":
                return self.send(200, capture)
            if path == f"/api/captures/{c['id']}/image.png" and image:
                return self.send(200, image, "image/png")
            name = "index.html" if path == "/" else path.lstrip("/")
            if name in ("index.html", "app.js", "style.css"):
                with open(os.path.join(UI, name), "rb") as f:
                    return self.send(200, f.read(), TYPES[os.path.splitext(name)[1]])
            self.send(404, b"")

        def do_POST(self):
            self.send(409, json.dumps({"error": "This needs the game running: the capture is opened from a file."}).encode())

        def log_message(self, *args):
            pass

    server = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    url = f"http://127.0.0.1:{port}/?capture={c['id']}"
    print(f"Fixframe: {os.path.basename(path)} at {url} (Ctrl+C to stop)")
    webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass


def main():
    parser = argparse.ArgumentParser(prog="fixframe", description="Fixframe: live render debugger for emulators and ports")
    sub = parser.add_subparsers(dest="command", required=True)
    o = sub.add_parser("open", help="open a saved capture (.ffcap) in the UI, no game needed")
    o.add_argument("file")
    o.add_argument("--port", type=int, default=7720)
    args = parser.parse_args()
    if args.command == "open":
        serve(args.file, args.port)


if __name__ == "__main__":
    main()
