# cmake -DOUT=<header> -DFILES="a;b" -P embed.cmake: the UI files as byte arrays (core/core.cpp serves them).
set(body "")
set(table "")
set(n 0)
foreach(f ${FILES})
  get_filename_component(name ${f} NAME)
  file(READ ${f} hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(APPEND body "static const unsigned char kAsset${n}[] = {${hex}};\n")
  if(name MATCHES "\\.html$")
    set(mime "text/html; charset=utf-8")
  elseif(name MATCHES "\\.css$")
    set(mime "text/css; charset=utf-8")
  else()
    set(mime "text/javascript; charset=utf-8")
  endif()
  string(APPEND table "  {\"${name}\", \"${mime}\", kAsset${n}, sizeof kAsset${n}},\n")
  math(EXPR n "${n} + 1")
endforeach()
file(WRITE ${OUT} "// generated by cmake/embed.cmake from ui/\n#pragma once\n#include <cstddef>\n\
struct Asset { const char* path; const char* mime; const unsigned char* data; size_t size; };\n${body}\
static const Asset kAssets[] = {\n${table}};\n")
